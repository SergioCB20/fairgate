# Entorno
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Datos: NUNCA en Git (licencia del dataset). Solo los descriptores .dvc.
data/**
!data/**/
!data/**/*.dvc
!data/**/.gitignore

# Linaje local de MLflow
mlflow.db
mlruns/
mlartifacts/

# Credenciales
kaggle.json
.dvc/config.local

# Sistema / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Salidas de la Zona 4 (derivadas del linaje)
lineage/
reports/

# Evaluación experimental (O4). Se versionan los resúmenes y las estimaciones (pequeños);
# los registros por repetición (.jsonl, ~44 MB) y los logs se publican como activo del release.
experiments/resultados/*
!experiments/resultados/evaluacion-dataset.md
!experiments/resultados/evaluacion-hist_gradient_boosting.md
!experiments/resultados/calibracion-dataset.md
!experiments/resultados/e6-evaluacion-dataset.md
!experiments/resultados/estabilidad-*.json
